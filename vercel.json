{
  "functions": {
    "api/saipos.js": {
      "supportsCancellation": true,
      "maxDuration": 300
    },
    "api/competition.js": {
      "maxDuration": 300
    },
    "api/kds.js": {
      "maxDuration": 300
    },
    "api/selecao.js": {
      "maxDuration": 180
    },
    "api/rh-documents.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/dirceu", "destination": "/api/saipos?unidade=dirceu" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
